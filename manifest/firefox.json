{
  "manifest_version": 3,
  "name": "upbookmarks",
  "version": "0.0.1",
  "description": "把书签与设置加密后备份到 Gitee 私有仓库（密码请交给 KeePassXC，本扩展不碰密码）",

  "browser_specific_settings": {
    "gecko": {
      "id": "upbookmarks@local",
      "strict_min_version": "115.0"
    }
  },

  "permissions": [
    "bookmarks",
    "storage",
    "alarms",
    "browserSettings",
    "privacy"
  ],

  "host_permissions": [
    "https://gitee.com/*"
  ],

  "background": {
    "scripts": ["src/background.js"],
    "service_worker": "src/background.js",
    "type": "module"
  },

  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  },

  "action": {
    "default_title": "upbookmarks",
    "default_popup": "src/ui/popup.html"
  }
}
