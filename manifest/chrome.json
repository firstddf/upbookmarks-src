{
  "manifest_version": 3,
  "name": "upbookmarks",
  "version": "0.0.1",
  "description": "把书签加密后备份到 Gitee 私有仓库（Chromium 无 browserSettings，只能备份书签；密码交给 KeePassXC）",

  "permissions": [
    "bookmarks",
    "storage",
    "alarms"
  ],

  "host_permissions": [
    "https://gitee.com/*"
  ],

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  },

  "action": {
    "default_title": "upbookmarks",
    "default_popup": "src/ui/popup.html"
  }
}
